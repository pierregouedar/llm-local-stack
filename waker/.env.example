# Copy to .env (next to docker-compose.yml), then: docker compose up -d
# MAC address of the server's network card (Wake-on-LAN).
#   Windows: Get-NetAdapter | Select Name, MacAddress     Linux: ip link
PC_MAC=AA:BB:CC:DD:EE:FF
# Broadcast address of the server's LAN (e.g. 192.168.1.255 for 192.168.1.0/24)
BROADCAST=192.168.1.255
# Server's Tailscale IP (tailscale ip -4 on the server), or its LAN IP without Tailscale
PC_IP=100.x.y.z
# Agent token: content of server/secrets/agent-token.txt on the server
AGENT_TOKEN=CHANGE-ME
# Ports (defaults)
AGENT_PORT=8090
LLAMA_PORT=8080
PCWAKE_PORT=8199
