# Copier en .env (meme dossier que docker-compose.yml), puis : docker compose up -d
# Adresse MAC de la carte reseau du PC (Wake-on-LAN). Windows : Get-NetAdapter | Select Name, MacAddress
PC_MAC=AA:BB:CC:DD:EE:FF
# Adresse de broadcast du reseau local du PC (ex. 192.168.1.255 pour 192.168.1.0/24)
BROADCAST=192.168.1.255
# IP Tailscale du PC (tailscale ip -4 sur le PC)
PC_IP=100.x.y.z
# Jeton de l'agent du PC : contenu de pc/secrets/agent-token.txt
AGENT_TOKEN=CHANGE-ME
# Ports (valeurs par defaut)
AGENT_PORT=8090
LLAMA_PORT=8080
PCWAKE_PORT=8199